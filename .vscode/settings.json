{
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.autoSave": "onWindowChange",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[cpp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[mql5]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[mql4]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "files.associations": {
    "*.mqh": "cpp",
    "*.mq5": "cpp",
    "*.mq4": "cpp"
  }
}
